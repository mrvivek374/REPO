# ---------------------------------------------------------------------------
# NEXORA environment configuration
# Copy this file to ".env" and fill in your own MySQL password.
#   Windows PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# Database engine: "mysql" (production / default) or "sqlite" (quick offline demo)
DB_ENGINE=mysql

# MySQL connection details
DB_NAME=nexora_db
DB_USER=nexora_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Used only when DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
